{
  "name": "wplace-RusMarble",
  "version": "0.87.99",
  "type": "module",
  "homepage": "https://t.me/ruswplace",
  "repository": {
    "type": "git",
    "url": "https://github.com/t-wy/Wplace-RusMarble-Userscripts.git"
  },
  "scripts": {
    "build:wasm": "node build/compile-wasm.js",
    "build": "node build/check-undefined.js && node build/build.js",
    "build:prod": "node build/build.js --prod",
    "build:dev": "node build/build.js --dev",
    "build:ex": "node build/check-undefined.js && node build/check-extension-points.js && node build/build-ex.js",
    "deploy:ex": "bash build/deploy-exp.sh --build",
    "test:png": "node --experimental-specifier-resolution=node build/test-template-png.js",
    "benchmark": "node build/benchmark.js",
    "patch": "node build/patch.js && npm run build",
    "check": "node build/check-undefined.js && node build/check-extension-points.js"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdoc": "^4.0.4",
    "minami": "^1.2.3",
    "terser": "^5.43.1",
    "wabt": "^1.0.39"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "^0.28.0"
  }
}
